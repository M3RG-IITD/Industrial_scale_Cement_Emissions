  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Correlation and operational feasibility penalty construction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#For fixing the raw meal flow rate\n",
    "lock_raw_meal_flow = True\n",
    "raw_meal_flow_index = 0  # or whatever the correct index is\n",
    "\n",
    "must_decrease_names = [\n",
    "    'Fuel consumption (calciner)'\n",
    "    ]\n",
    "\n",
    "names = list(optimization_df.iloc[[0], 3:-9])\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# CORRELATION CONSTRAINT MODELS  (Mahalanobis on corr structure)\n",
    "# -------------------------------------------------------\n",
    "corr_df = df_filtered_quantile[names].copy()\n",
    "corr_df.dropna(inplace=True)\n",
    "\n",
    "corr_scaler = StandardScaler()\n",
    "C_scaled = corr_scaler.fit_transform(corr_df)\n",
    "\n",
    "# Mean & covariance (correlation realism)\n",
    "corr_mean = C_scaled.mean(axis=0)\n",
    "corr_cov = np.cov(C_scaled, rowvar=False)\n",
    "corr_inv_cov = np.linalg.pinv(corr_cov)\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# REALISM CONSTRAINT MODELS (Mahalanobis on full cluster)\n",
    "# -------------------------------------------------------\n",
    "historical_PP_df = df_filtered_quantile[names].copy()\n",
    "historical_PP_df.dropna(inplace=True)\n",
    "\n",
    "realism_scaler = StandardScaler()\n",
    "H_scaled = realism_scaler.fit_transform(historical_PP_df)\n",
    "\n",
    "realism_mean = H_scaled.mean(axis=0)\n",
    "realism_cov = np.cov(H_scaled, rowvar=False)\n",
    "realism_inv_cov = np.linalg.pinv(realism_cov)\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# Weights (ONLY these two are needed)\n",
    "# -------------------------------------------------------\n",
    "W_CORR = 0.20          # correlation realism weight\n",
    "W_REALMAHAL = 0.15     # operating-cluster realism weight # both of these vary from 0 to 1"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Initializations for the optimization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "kiln_fuel_index = names.index('Fuel consumption (kiln)')\n",
    "calciner_fuel_index = names.index('Fuel consumption (calciner)')\n",
    "\n",
    "Op_ip_names = list(optimization_df.iloc[[0],:-9] )\n",
    "\n",
    "# Initialize parameters\n",
    "POPULATION_SIZE = 50\n",
    "GENES = len(names)  # Assuming names is a list of parameters\n",
    "GENERATIONS = 35\n",
    "MUTATION_RATE = 0.1\n",
    "TOURNAMENT_SIZE = 5\n",
    "RANGE_PERCENTAGE = 0.05 #5% change"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Defining functions for the optimization algorithm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def initialize_population():\n",
    "    population = []\n",
    "    for _ in range(POPULATION_SIZE):\n",
    "        individual = np.random.uniform(lower_bounds, upper_bounds)\n",
    "        if lock_raw_meal_flow:\n",
    "            individual[raw_meal_flow_index] = fixed_raw_meal\n",
    "        population.append(individual)\n",
    "    return population\n",
    "\n",
    "def fitness(individual):\n",
    "    inputs = np.array(individual).flatten()\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # 1. Parameters that must NOT increase\n",
    "    # ----------------------------------------------------\n",
    "    must_decrease_indexes = [names.index(name) for name in must_decrease_names]\n",
    "    for idx in must_decrease_indexes:\n",
    "        if inputs[idx] > initial_values[idx]:\n",
    "            return 1e6, None   # hard penalty\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # 2. Total fuel must NOT increase\n",
    "    # ----------------------------------------------------\n",
    "    initial_total_fuel = initial_values[kiln_fuel_index] + initial_values[calciner_fuel_index]\n",
    "    new_total_fuel = inputs[kiln_fuel_index] + inputs[calciner_fuel_index]\n",
    "    if new_total_fuel > initial_total_fuel:\n",
    "        return 1e6, None\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # Build dataframe for ML models\n",
    "    # ----------------------------------------------------\n",
    "    model_inputs_df = pd.DataFrame([inputs], columns=names)\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # 3. Predict NOx\n",
    "    # ----------------------------------------------------\n",
    "    nox = model_nox_control.predict(model_inputs_df)[0]\n",
    "\n",
    "    # ====================================================\n",
    "    # ✅ REALISM & CORRELATION PENALTIES START HERE\n",
    "    # ====================================================\n",
    "\n",
    "    # ------- A) CORRELATION REALISM PENALTY -------\n",
    "    x_corr_scaled = corr_scaler.transform(model_inputs_df)[0]\n",
    "    diff_corr = x_corr_scaled - corr_mean\n",
    "    corr_penalty = diff_corr @ corr_inv_cov @ diff_corr.T\n",
    "\n",
    "    # ------- B) OPERATING-CLUSTER REALISM PENALTY -------\n",
    "    x_real_scaled = realism_scaler.transform(model_inputs_df)[0]\n",
    "    diff_real = x_real_scaled - realism_mean\n",
    "    realmahal_penalty = diff_real @ realism_inv_cov @ diff_real.T\n",
    "\n",
    "    # Add realism penalties to NOx\n",
    "    nox += W_CORR * corr_penalty + W_REALMAHAL * realmahal_penalty\n",
    "\n",
    "    # ====================================================\n",
    "    # ✅ REALISM & CORRELATION PENALTIES END HERE\n",
    "    # ====================================================\n",
    "\n",
    "    # ----------------------------------------------------\n",
    "    # 4. Clinker flow soft constraint\n",
    "    # ----------------------------------------------------\n",
    "    clinker_flow_pred = model_clk.predict(model_inputs_df)[0]\n",
    "\n",
    "    if 0.995 * initial_clinker_value <= clinker_flow_pred <= initial_clinker_value:\n",
    "        return nox, clinker_flow_pred\n",
    "\n",
    "    # Soft penalty for clinker violation\n",
    "    clinker_penalty = abs(0.995 * initial_clinker_value - clinker_flow_pred) * 1000\n",
    "\n",
    "    return nox + clinker_penalty, clinker_flow_pred\n",
    "\n",
    "\n",
    "\n",
    "def select_parent(population, fitness_scores):\n",
    "    tournament = random.sample(range(POPULATION_SIZE), TOURNAMENT_SIZE)\n",
    "    tournament_fitness = [fitness_scores[i] for i in tournament]\n",
    "    winner_idx = tournament[np.argmin(tournament_fitness)]\n",
    "    return population[winner_idx]\n",
    "\n",
    "def crossover(parent1, parent2):\n",
    "    point = random.randint(1, GENES - 1)\n",
    "    child1 = np.concatenate((parent1[:point], parent2[point:]))\n",
    "    child2 = np.concatenate((parent2[:point], parent1[point:]))\n",
    "\n",
    "    if lock_raw_meal_flow:\n",
    "        child1[raw_meal_flow_index] = fixed_raw_meal\n",
    "        child2[raw_meal_flow_index] = fixed_raw_meal\n",
    "\n",
    "    return child1, child2\n",
    "\n",
    "\n",
    "\n",
    "def mutate(individual):\n",
    "    individual = individual.copy()\n",
    "    for gene in range(GENES):\n",
    "        if lock_raw_meal_flow and gene == raw_meal_flow_index:\n",
    "            continue  # skip mutation for locked variable\n",
    "\n",
    "        if random.random() < MUTATION_RATE:\n",
    "            individual[gene] = np.clip(\n",
    "                individual[gene] + np.random.uniform(-input_range[gene], input_range[gene]),\n",
    "                lower_bounds[gene],\n",
    "                upper_bounds[gene]\n",
    "            )\n",
    "\n",
    "    if lock_raw_meal_flow:\n",
    "        individual[raw_meal_flow_index] = fixed_raw_meal\n",
    "    return individual\n",
    "\n",
    "def genetic_algorithm():\n",
    "    population = initialize_population()\n",
    "\n",
    "    for generation in range(GENERATIONS):\n",
    "        fitness_results = [fitness(individual) for individual in population]\n",
    "        fitness_scores = [result[0] for result in fitness_results]   # NOx\n",
    "        clinker_flows = [result[1] for result in fitness_results]    # clinker\n",
    "\n",
    "        new_population = []\n",
    "\n",
    "        while len(new_population) < POPULATION_SIZE:\n",
    "            parent1 = select_parent(population, fitness_scores)\n",
    "            parent2 = select_parent(population, fitness_scores)\n",
    "\n",
    "            child1, child2 = crossover(parent1, parent2)\n",
    "\n",
    "            child1 = mutate(child1)\n",
    "            child2 = mutate(child2)\n",
    "\n",
    "            new_population.extend([child1, child2])\n",
    "\n",
    "        population = new_population[:POPULATION_SIZE]\n",
    "\n",
    "        # best_fitness = min(fitness_scores)\n",
    "        best_idx = np.argmin(fitness_scores)\n",
    "        best_fitness = fitness_scores[best_idx]\n",
    "        best_clinker = clinker_flows[best_idx]\n",
    "        # Print both NOx and clinker flow\n",
    "        print(f\"Generation {generation + 1}: Best Fitness = {best_fitness:.4f}, Clinker Flow = {best_clinker}\")\n",
    "        # print(f\"Generation {generation + 1}: Best Fitness = {best_fitness:.4f}\")\n",
    "\n",
    "    # Final selection based on valid solutions only\n",
    "    fitness_results = [fitness(individual) for individual in population]\n",
    "    fitness_scores = [result[0] for result in fitness_results]\n",
    "    clinker_flows = [result[1] for result in fitness_results]\n",
    "\n",
    "    valid_results = [(ind, score, clinker) for ind, score, clinker in zip(population, fitness_scores, clinker_flows) if clinker is not None]\n",
    "\n",
    "    if valid_results:\n",
    "        best_individual, best_score, best_clinker = min(valid_results, key=lambda x: x[1])\n",
    "    else:\n",
    "        best_individual, best_score, best_clinker = population[0], 1e6, None\n",
    "\n",
    "    return best_individual, best_score, best_clinker"
   ]
  },
