    "def fcao_clk_plot(clinker_change, fcao, fcao_opt,fig_path = None):\n",
    "    x = range(len(fcao))\n",
    "    w  = 0.5\n",
    "    lw = 1\n",
    "    s_marker = 18\n",
    "    \n",
    "    s_tick_label = 16\n",
    "    s_axis_label = 16\n",
    "    s_tick_label_x = 14\n",
    "    \n",
    "    fcao_col = '#CB4C83' \n",
    "    fcao_opt_col =  'lightseagreen'\n",
    "    clinker_col = 'steelblue'\n",
    "\n",
    "    matplotlib.rcParams['axes.linewidth'] = w\n",
    "    fig, ax = plt.subplots(figsize=(7, 3.5))\n",
    "\n",
    "    _=ax.set_frame_on(True)\n",
    "    _=ax.patch.set_visible(False)\n",
    "    _=plt.setp(ax.spines.values(), visible=False)\n",
    "    _=ax.spines[\"left\"].set_visible(True)\n",
    "    _=ax.spines[\"top\"].set_visible(False)\n",
    "    _=ax.spines[\"bottom\"].set_visible(True)\n",
    "\n",
    "    _= ax.spines['left'].set_position(('outward', 10))\n",
    "    _= ax.spines['bottom'].set_position(('outward', 10))\n",
    "        \n",
    "    _= plt.scatter(x, fcao, color = fcao_col, marker = 'x' , s = s_marker)\n",
    "    _= plt.scatter(x, fcao_opt, color = fcao_opt_col, marker = 'o' , s = s_marker)\n",
    "\n",
    "    _=plt.tick_params(axis = 'y', which = 'both', left = 'True', width = w, direction = 'in')\n",
    "    _=plt.tick_params(axis = 'x', which = 'both', width = w, top = False, bottom = True, direction = 'in')\n",
    "    _=plt.tick_params(axis = 'both', which = 'major', length = 8)\n",
    "    _=plt.tick_params(axis = 'both', which = 'minor', length = 4)\n",
    "    _= ax.yaxis.set_minor_locator(AutoMinorLocator(2))\n",
    "    _= ax.xaxis.set_minor_locator(AutoMinorLocator(2))\n",
    "\n",
    "    _=plt.yticks( fontsize=s_tick_label, fontweight= 'normal')\n",
    "    _=plt.xticks( fontsize= s_tick_label_x, fontweight= 'normal', rotation = 0)\n",
    "\n",
    "    _= plt.ylabel( 'f-CaO [wt. %]', fontsize= s_axis_label, fontweight = 'normal')\n",
    "    _= plt.xlabel( 'Optimization trial', fontsize= s_axis_label, fontweight = 'normal')\n",
    "\n",
    "    _=ax2 = ax.twinx()\n",
    "    _= ax2.spines['right'].set_position(('outward', 10))\n",
    "    _=ax2.set_ylim(-5, 5)\n",
    "    _= plt.plot(x, clinker_change, color = clinker_col, lw =1.2)\n",
    "    _=plt.tick_params(axis = 'y', which = 'both', right = 'True', color = clinker_col, width = w, direction = 'in')\n",
    "    _=plt.tick_params(axis = 'x', which = 'both', width = w, direction = 'in')\n",
    "    _=plt.tick_params(axis = 'both', which = 'major', length = 8)\n",
    "    _=plt.tick_params(axis = 'both', which = 'minor', length = 4)\n",
    "    _=plt.yticks( fontsize=s_tick_label, fontweight= 'normal', color = clinker_col)\n",
    "\n",
    "    _= ax2.yaxis.set_minor_locator(AutoMinorLocator(2))\n",
    "    _= ax2.xaxis.set_minor_locator(AutoMinorLocator(2))\n",
    "\n",
    "    _=ax2.set_frame_on(True)\n",
    "    _=ax2.patch.set_visible(False)\n",
    "    _=plt.setp(ax2.spines.values(), visible=False)\n",
    "    _=ax2.spines[\"right\"].set_visible(True)\n",
    "    _=ax2.yaxis.label.set_color(clinker_col)\n",
    "    _=ax2.spines[\"right\"].set_edgecolor(clinker_col)\n",
