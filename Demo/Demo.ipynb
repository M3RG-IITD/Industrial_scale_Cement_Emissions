    "def cmap_hist(data,Label, cmap_name=\"viridis\", color_by=\"value\", fig_path = None, xticks = None, tsne= True):\n",
    "    print(f'Mean of data = {np.mean(data)}')\n",
    "    bins= int(1+3.3*np.log(len(data)))\n",
    "    s = 12\n",
    "    w = 0.5\n",
    "    fig, ax = plt.subplots(figsize=(1.8, 1.8))\n",
    "    _= ax.spines['top'].set_visible(False)\n",
    "    _= ax.spines['right'].set_visible(False)\n",
    "    _= plt.yticks(fontsize=s, fontweight='normal', rotation = 90)\n",
    "    for label in plt.gca().get_yticklabels():\n",
    "        label.set_verticalalignment('center')  # or shorthand: label.set_va('center')\n",
    "        # label.set_horizontalalignment('center')  # or label.set_ha('center')\n",
    "    \n",
    "    if xticks == None:\n",
    "        _= plt.xticks(fontsize=s, fontweight='normal')\n",
    "    else:\n",
    "        _= plt.xticks(xticks, xticks ,fontsize=s, fontweight='normal') #Similarity\n",
    "    \n",
    "    _= ax.tick_params(which = 'major', width= w, length = 5)\n",
    "    _= ax.tick_params(which = 'minor', width= w, length = 2)\n",
    "    _= ax.tick_params(axis='x', direction ='in', which = 'both')\n",
    "    _=plt.tick_params(axis = 'y', which = 'both', left = 'True', right = False, width = w, direction = 'in')\n",
    "    _= ax.tick_params(axis='x', which='both', top = False)\n",
    "    _= ax.xaxis.set_minor_locator(AutoMinorLocator(1))\n",
    "    _= ax.yaxis.set_minor_locator(AutoMinorLocator(1))\n",
    "\n",
    "    matplotlib.rcParams['axes.linewidth'] = 0.5\n",
    "    w =0.5\n",
    "    \n",
    "    counts, bins, patches = ax.hist(data, bins=bins, edgecolor=None)\n",
    "    if color_by == \"value\":\n",
    "        values = 0.5 * (bins[:-1] + bins[1:])\n",
    "        norm = Normalize(vmin=values.min(), vmax=values.max())\n",
    "    else:  # color_by == \"count\"\n",
    "        values = counts\n",
    "        if tsne:\n",
    "            norm = Normalize(vmin= 153.9, vmax= 899.13)\n",
    "        else:\n",
    "            norm = Normalize(vmin=counts.min(), vmax=counts.max())\n",
    "\n",
    "    cmap = cm.get_cmap(cmap_name)\n",
    "    for val, patch in zip(values, patches):\n",
    "        patch.set_facecolor(cmap(norm(val)))\n",
    "\n",
    "    sm = cm.ScalarMappable(norm=norm, cmap=cmap)\n",
    "    # plt.colorbar(sm, ax=ax, label=f\"Color by {color_by}\")\n",
    "    plt.xlim(_,920)\n",
    "    ax.set_xlabel(Label, fontsize=s)\n",
    "    ax.set_ylabel(\"Count\",fontsize=s)\n",
