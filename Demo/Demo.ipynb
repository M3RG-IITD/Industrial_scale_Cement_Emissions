    "df = backbone.copy()\n",
    "parameter_names = df.iloc[:, 0]\n",
    "data = df.iloc[:, 1:].astype(float)\n",
    "\n",
    "# Define the parameters you want to exclude\n",
    "excluded_parameters = ['NOx content in the raw gas (preheater outlet)', 'Clinker production', 'free_lime', 'Raw meal mass flow rate (to preheater)']  \n",
    "\n",
    "# Create a mask to exclude the selected parameters\n",
    "mask = ~parameter_names.isin(excluded_parameters)\n",
    "filtered_names = parameter_names[mask]\n",
