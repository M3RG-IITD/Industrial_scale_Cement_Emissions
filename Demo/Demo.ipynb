    "def nox_old_new(nox_old, nox_new,fig_path = None):\n",
    "    x = range(len(nox_old))\n",
    "    w  = 0.5\n",
    "    lw = 0.5\n",
    "    \n",
    "    s_tick_label = 10\n",
    "    s_axis_label = 10\n",
    "    \n",
    "    nox_old_col =  'indianred'\n",
    "    nox_new_col = '#8baaad'\n",
    "\n",
    "    matplotlib.rcParams['axes.linewidth'] = w\n",
    "    fig, ax = plt.subplots(figsize=(3, 1.5))\n",
    "\n",
    "    _=ax.set_frame_on(True)\n",
    "    _=ax.patch.set_visible(False)\n",
    "    _=plt.setp(ax.spines.values(), visible=False)\n",
    "    _=ax.spines[\"left\"].set_visible(True)\n",
    "    _=ax.spines[\"top\"].set_visible(False)\n",
    "    _=ax.spines[\"bottom\"].set_visible(True)\n",
    "\n",
    "    _= ax.spines['left'].set_position(('outward', 13))\n",
    "    _= ax.spines['bottom'].set_position(('outward', 13))\n",
    "        \n",
    "    _= plt.plot(x, nox_new, color = nox_new_col, lw = 1.5, ls = 'solid', rasterized=True)\n",
    "    _= plt.plot(x, nox_old, color = nox_old_col, lw = 1.5,ls = 'solid')\n",
    "\n",
    "    _=plt.tick_params(axis = 'y', which = 'both', left = 'True', width = w, direction = 'in')\n",
    "    _=plt.tick_params(axis = 'x', which = 'both', width = w, top = False, bottom = True, direction = 'in')\n",
    "    _=plt.tick_params(axis = 'both', which = 'major', length = 5)\n",
    "    _=plt.tick_params(axis = 'both', which = 'minor', length = 2.5)\n",
    "    _= ax.yaxis.set_minor_locator(AutoMinorLocator(2))\n",
    "    _= ax.xaxis.set_minor_locator(AutoMinorLocator(2))\n",
    "\n",
    "    _=plt.yticks( fontsize=s_tick_label, fontweight= 'normal')\n",
    "    _=plt.xticks( fontsize= s_tick_label, fontweight= 'normal', rotation = 0)\n",
    "\n",
    "    _= plt.ylabel( '$NO_{x}$ [PPM]', fontsize= s_axis_label, fontweight = 'normal')\n",
    "    _= plt.xlabel( 'Optimization trial', fontsize= s_axis_label, fontweight = 'normal')\n",
    "    \n",
    "    if fig_path != None:\n",
    "        _= plt.savefig(fig_path, bbox_inches='tight', transparent = True, dpi = 1000)  \n",
    "    plt.tight_layout()    \n",
    "    _=plt.show()"
   ]
