    "def plot_embeddings(\n",
    "    hist_emb,\n",
    "    orig_emb,\n",
    "    opt_emb,\n",
    "    original_nox,\n",
    "    optimized_nox,\n",
    "    cmap,\n",
    "    label, \n",
    "    show_cmap,\n",
    "    use_3d=False,\n",
    "    show_hull=False,\n",
    "    show_arrows=False,\n",
    "    show_pair_lines=False,\n",
    "    single_colorbar=True,\n",
    "    show_historical=False,\n",
    "    single_plot=False,\n",
    "):\n",
    "    marker_size = 90 \n",
    "    edge_col = 'dimgray'\n",
    "    border_lw = 0.5\n",
    "    \n",
    "    back_col = 'black'\n",
    "    alpha_col = 0.03\n",
    "    \n",
    "    \n",
    "    # ---------- Shared colorbar limits ----------\n",
    "    global_min = min(original_nox.min(), optimized_nox.min())\n",
    "    global_max = max(original_nox.max(), optimized_nox.max())\n",
    "\n",
    "    n_orig = len(orig_emb)\n",
    "    n_opt = len(opt_emb)\n",
    "\n",
    "    # ---------- Helper: hull ----------\n",
    "    def draw_hull(ax, pts):\n",
    "        if pts is None or len(pts) < (4 if use_3d else 3):\n",
    "            return\n",
    "        hull = ConvexHull(pts)\n",
    "        if use_3d:\n",
    "            for s in hull.simplices:\n",
    "                ax.plot(pts[s,0], pts[s,1], pts[s,2], color=\"black\", alpha=0.99, ls = 'dashed', lw = 0.5, rasterized = True)\n",
    "        else:\n",
    "            for s in hull.simplices:\n",
    "                ax.plot(pts[s,0], pts[s,1], color=\"black\", alpha=0.75, ls = 'dashed', lw = 0.5)\n",
    "    # ---------- Helper: create axis ----------\n",
    "    def create_axis(title):\n",
    "        fig = plt.figure(figsize=(5,5))\n",
    "        ax = fig.add_subplot(111, projection=\"3d\") if use_3d else fig.add_subplot(111)\n",
    "        # ax.grid(True)\n",
    "        return fig, ax\n",
    "\n",
    "    # ---------- Helper: scatter plot ----------\n",
    "    def draw_points(ax, emb, nox, label, marker):\n",
    "        if use_3d:\n",
    "            return ax.scatter(\n",
    "                emb[:,0], emb[:,1], emb[:,2],\n",
    "                c=nox, cmap= cmap,\n",
    "                vmin=global_min, vmax=global_max,\n",
    "                s= marker_size, marker=marker, edgecolors=\"dimgray\",\n",
    "                label=label,\n",
    "                linewidths=0.5, rasterized = True\n",
    "            )\n",
    "        else:\n",
    "            return ax.scatter(\n",
    "                emb[:,0], emb[:,1],\n",
    "                c=nox, cmap= cmap,\n",
    "                vmin=global_min, vmax=global_max,\n",
    "                s= marker_size, marker=marker, edgecolors=\"dimgray\",\n",
    "                linewidths=0.5,\n",
    "                label=label\n",
    "            )\n",
    "\n",
    "    # ---------- Helper: connections ----------\n",
    "    def draw_connections(ax):\n",
    "        for i in range(min(n_orig, n_opt)):\n",
    "            a = orig_emb[i]\n",
    "            b = opt_emb[i]\n",
    "            if show_pair_lines:\n",
    "                if use_3d:\n",
    "                    ax.plot([a[0],b[0]],[a[1],b[1]],[a[2],b[2]], color=\"blue\", linewidth=1.2, rasterized = True)\n",
    "                else:\n",
    "                    ax.plot([a[0],b[0]],[a[1],b[1]], color=\"blue\", linewidth=1.2)\n",
    "            if show_arrows:\n",
    "                if use_3d:\n",
    "                    ax.quiver(a[0],a[1],a[2], b[0]-a[0], b[1]-a[1], b[2]-a[2],\n",
    "                              color=\"black\", arrow_length_ratio=0.15, rasterized = True)\n",
    "                else:\n",
    "                    ax.annotate(\"\", xy=(b[0],b[1]), xytext=(a[0],a[1]),\n",
    "                                arrowprops=dict(arrowstyle=\"->\", color=\"black\"), rasterized = True)\n",
    "\n",
    "    # ============================================================\n",
    "    # CASE 1: SINGLE COMBINED PLOT\n",
    "    # ============================================================\n",
    "    if single_plot:\n",
    "        fig, ax = create_axis(\"Embeddings — Combined Original + Optimized\")\n",
    "        if show_historical and hist_emb is not None:\n",
    "            if use_3d:\n",
    "                ax.scatter(hist_emb[:,0], hist_emb[:,1], hist_emb[:,2],\n",
    "                           facecolor=\"lightgrey\", s=90, edgecolor= 'black', rasterized = True)\n",
    "            else:\n",
    "                ax.scatter(hist_emb[:,0], hist_emb[:,1],\n",
    "                           facecolor=\"lightgrey\", s=90, edgecolor= 'dimgray', rasterized = True)\n",
    "\n",
    "        sc_orig = draw_points(ax, orig_emb, original_nox, \"Original Trials\", \"o\")\n",
    "        sc_opt  = draw_points(ax, opt_emb, optimized_nox, \"Optimized Trials\", \"^\")\n",
    "        draw_connections(ax)\n",
    "\n",
    "        # Draw convex hull if requested\n",
    "        if show_hull and hist_emb is not None:\n",
    "            draw_hull(ax, hist_emb, rasterized = True)\n",
    "\n",
    "        cbar = fig.colorbar(sc_opt, ax=ax)\n",
    "        cbar.set_label(\"NOx (Shared Scale)\")\n",
    "        plt.show()\n",
    "        return\n",
    "\n",
    "    # ----- FIGURE 1: original -----\n",
    "    fig1, ax1 = create_axis(\"Embeddings — Original Trials\")\n",
    "    _= ax1.tick_params(axis='both', which = 'both',bottom = False, left = False)\n",
    "    ax1.set_yticklabels([])\n",
    "    ax1.set_xticklabels([])\n",
    "    ax1.set_zticklabels([])\n",
    "    ax1.set_xticks([])\n",
    "    ax1.set_yticks([])\n",
    "    ax1.set_zticks([])\n",
    "    \n",
    "    ax1.xaxis.pane.set_visible(True)   # or False to hide\n",
    "    ax1.yaxis.pane.set_visible(True)\n",
    "    ax1.zaxis.pane.set_visible(True)\n",
    "    \n",
    "    [spine.set_visible(False) for spine in ax1.spines.values()]\n",
    "    if show_historical and hist_emb is not None:\n",
    "        if use_3d:\n",
    "            ax1.scatter(hist_emb[:,0], hist_emb[:,1], hist_emb[:,2],facecolors=mcolors.to_rgba('gainsboro', alpha=0.99), s= marker_size, edgecolors= 'darkgray', linewidth = 0.5, rasterized = True)\n",
    "        else:\n",
    "            ax1.scatter(hist_emb[:,0], hist_emb[:,1],facecolors=mcolors.to_rgba('gainsboro', alpha=0.99), s= marker_size, edgecolors= 'darkgray', linewidth = 0.5, rasterized = True)\n",
    "    sc1 = draw_points(ax1, orig_emb, original_nox, \"Original Trials\", \"o\")\n",
    "    cbar= add_cmap_legend(\n",
    "    fig1, ax1, sc1,\n",
    "    show=show_cmap,                    # set False to hide cmap legend\n",
    "    label=label\n",
    "    )\n",
    "    draw_connections(ax1)\n",
    "    if show_hull and hist_emb is not None:\n",
    "        draw_hull(ax1, hist_emb)\n",
    "    \n",
    "    #Background color\n",
    "    for axis in [ax1.xaxis, ax1.yaxis, ax1.zaxis]:\n",
    "        axis.pane.set_facecolor(back_col)\n",
    "        axis.pane.set_alpha(alpha_col)\n",
    "        \n",
    "    #far edge color\n",
    "    for axis in [ax1.xaxis, ax1.yaxis, ax1.zaxis]:\n",
    "        axis.line.set_color(edge_col)\n",
    "        axis.line.set_linewidth(border_lw)\n",
    "    draw_corner_edges(ax1, corner=2, color=edge_col, lw= border_lw)\n",
    "    \n",
    "    # if not single_colorbar:\n",
    "    #     fig1.colorbar(sc1, ax=ax1).set_label(\"NOx\")\n",
    "    \n",
    "    fig_path =  '/home/m3rg2000/Junaid_temporary/saved_data/Paper_figures/optimize/PP_raw_high.pdf'\n",
    "    _= plt.savefig(fig_path, bbox_inches='tight', transparent = True, dpi = 600) \n",
    "    plt.show()\n",
    "\n",
    "    # ----- FIGURE 2: optimized -----\n",
    "    fig2, ax2 = create_axis(\"Embeddings — Optimized Trials\")\n",
    "    _= ax2.tick_params(axis='both', which = 'both',bottom = False, left = False)\n",
    "    ax2.set_yticklabels([])\n",
    "    ax2.set_xticklabels([])\n",
    "    ax2.set_zticklabels([])\n",
    "    ax2.set_xticks([])\n",
    "    ax2.set_yticks([])\n",
    "    ax2.set_zticks([])\n",
    "    [spine.set_visible(False) for spine in ax2.spines.values()]\n",
    "    if show_historical and hist_emb is not None:\n",
    "        if use_3d:\n",
    "            ax2.scatter(hist_emb[:,0], hist_emb[:,1], hist_emb[:,2],facecolors=mcolors.to_rgba('gainsboro', alpha=0.99), s= marker_size, edgecolors= 'darkgray', linewidth = 0.5)\n",
    "        else:\n",
    "            ax2.scatter(hist_emb[:,0], hist_emb[:,1],facecolors=mcolors.to_rgba('gainsboro', alpha=0.99), s= marker_size, edgecolors= 'darkgray', linewidth = 0.5)\n",
    "    sc2 = draw_points(ax2, opt_emb, optimized_nox, \"Optimized Trials\", \"^\")\n",
    "    cbar= add_cmap_legend(\n",
    "    fig2, ax2, sc2,\n",
    "    show=show_cmap,                    # set False to hide cmap legend\n",
    "    label=label\n",
    "    )\n",
    "    draw_connections(ax2)\n",
    "    if show_hull and hist_emb is not None:\n",
    "        draw_hull(ax2, hist_emb)\n",
    "        #Background color\n",
    "    for axis in [ax2.xaxis, ax2.yaxis, ax2.zaxis]:\n",
    "        axis.pane.set_facecolor(back_col)\n",
    "        axis.pane.set_alpha(alpha_col)\n",
    "        \n",
    "    #far edge color\n",
    "    for axis in [ax2.xaxis, ax2.yaxis, ax2.zaxis]:\n",
    "        axis.line.set_color('white')\n",
    "        axis.line.set_linewidth(0.5)\n",
    "    draw_corner_edges(ax2, corner=2, color=edge_col, lw= border_lw)\n",
    "    \n",
    "    # if not single_colorbar:\n",
    "    #     fig2.colorbar(sc2, ax=ax2).set_label(\"NOx\")    \n",
    "    \n",
    "    fig_path =  '/home/m3rg2000/Junaid_temporary/saved_data/Paper_figures/optimize/PP_opt_high.pdf'\n",
    "    # fig_path =  '/home/m3rg2000/Junaid_temporary/saved_data/Paper_figures/optimize/similarity_high.pdf'\n",
    "    # fig_path =  '/home/m3rg2000/Junaid_temporary/saved_data/Paper_figures/optimize/similarity_high_cbar.pdf'\n",
    "    _= plt.savefig(fig_path, bbox_inches='tight', transparent = True, dpi = 600) \n",
    "    plt.show()"
   ]
