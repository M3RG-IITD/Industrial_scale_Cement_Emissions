   "source": [
    "### Manhattan distance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run time = 3.5 min\n",
    "similarity_results = []\n",
    "comparison_tables = []\n",
    "\n",
    "cols = [\n",
    "    'NOx content in the raw gas (preheater outlet)',\n",
    "    'Clinker production',\n",
    "    'kiln inlet pressure',\n",
    "    'Fuel consumption (calciner)',\n",
    "    'Driver of rotary kiln',\n",
    "    'Fuel consumption (kiln)',\n",
    "    'Rotational speed of each fan', \n",
    "    'Total cooling air', \n",
    "    'I Air (including transport air)',\n",
    "]\n",
    "\n",
    "df = df_merged_Na_removed[cols]\n",
    "\n",
    "# Normalize plant data once\n",
    "scaler = MinMaxScaler()\n",
    "df_scaled = pd.DataFrame(scaler.fit_transform(df), columns=df.columns)\n",
    "\n",
    "# Iterate over 19 optimized input files\n",
    "for i in list(backbone.columns[1:]):\n",
    "    # Load optimized and initial inputs\n",
    "    stats = pd.read_csv(f'optimization_generated_files/optimize_compare_row{i}.csv')\n",
    "\n",
    "    a_opt = stats[['Unnamed: 0', 'new']].T.reset_index().drop(columns=['index'])\n",
    "    a_opt.columns = a_opt.iloc[0]\n",
    "    a_opt = a_opt[1:].reset_index(drop=True)\n",
    "    a_opt = a_opt[cols]\n",
    "    a_opt_row = a_opt.copy()\n",
    "\n",
    "    a_init = stats[['Unnamed: 0', 'initial']].T.reset_index().drop(columns=['index'])\n",
    "    a_init.columns = a_init.iloc[0]\n",
    "    a_init = a_init[1:].reset_index(drop=True)\n",
    "    a_init = a_init[cols]\n",
    "    a_init_row = a_init.copy()\n",
    "\n",
    "    # Normalize optimized input\n",
    "    a_scaled = pd.DataFrame(scaler.transform(a_opt_row), columns=a_opt_row.columns)\n",
    "\n",
    "    # Manhattan distance with normalized operational data\n",
    "    distances = np.abs(df_scaled.values - a_scaled.values[0]).sum(axis=1)\n",
    "    closest_idx = distances.argmin()\n",
    "    closest_distance = distances[closest_idx]\n",
    "\n",
    "    # Calculate similarity\n",
    "    n_features = df.shape[1]\n",
    "    similarity_percent = (1 - (closest_distance / n_features)) * 100\n",
    "\n",
    "    # Store summary result\n",
    "    similarity_results.append({\n",
    "        'File Index': i,\n",
    "        'Closest Row Index': closest_idx,\n",
    "        'Manhattan Distance': closest_distance,\n",
    "        'Similarity (%)': similarity_percent\n",
    "    })\n",
    "\n",
    "    # Original values from the closest row\n",
    "    matched_row_original = df.iloc[closest_idx]\n",
    "\n",
    "    # Comparison table including initial input\n",
    "    comparison = pd.DataFrame({\n",
    "        'Initial Input': a_init_row.values[0],\n",
    "        'Optimized Input': a_opt_row.values[0],\n",
    "        'Closest Match': matched_row_original.values,\n",
    "        '% Difference (Opt vs Match)': 100 * np.abs(a_opt_row.values[0] - matched_row_original.values) / np.abs(a_opt_row.values[0])\n",
    "    }, index=cols)\n",
    "\n",
    "    comparison_tables.append(comparison)\n",
    "# Summary DataFrame of similarity across all optimized inputs\n",
    "summary_df = pd.DataFrame(similarity_results)"
   ]
  },
