    "def draw_corner_edges(ax, corner=1, color='dimgray', lw=0.5):\n",
    "    x0, x1 = ax.get_xlim3d()\n",
    "    y0, y1 = ax.get_ylim3d()\n",
    "    z0, z1 = ax.get_zlim3d()\n",
    "\n",
    "    # map corner number → coordinates (x, y, z)\n",
    "    corner_map = {\n",
    "        1: (x0, y0, z0),\n",
    "        2: (x0, y1, z0),\n",
    "        3: (x1, y1, z0),\n",
    "        4: (x1, y0, z0),\n",
    "        5: (x0, y0, z1),\n",
    "        6: (x0, y1, z1),\n",
    "        7: (x1, y1, z1),\n",
    "        8: (x1, y0, z1),\n",
    "    }\n",
    "\n",
    "    if corner not in corner_map:\n",
    "        raise ValueError(\"corner must be an integer between 1 and 8\")\n",
    "\n",
    "    cx, cy, cz = corner_map[corner]\n",
    "\n",
    "    # opposite ends\n",
    "    ox = x1 if cx == x0 else x0\n",
    "    oy = y1 if cy == y0 else y0\n",
    "    oz = z1 if cz == z0 else z0\n",
    "    \n",
    "    ax.plot([cx, ox], [cy, cy], [cz, cz], color=color, lw=lw)  # X edge\n",
    "    ax.plot([cx, cx], [cy, oy], [cz, cz], color=color, lw=lw)  # Y edge\n",
    "    ax.plot([cx, cx], [cy, cy], [cz, oz], color=color, lw=lw)  # Z edge\n"
   ]
