    "    initial_values_kf = optimization_df.iloc[[row],-9:]  # excluding KF \n",
    "    initial_values_OP_PP = optimization_df.iloc[[row],:-9] \n",
    "   \n",
    "    initial_values = initial_values_df.values\n",
    "    initial_values = initial_values.flatten()\n",
    "\n",
    "    fixed_raw_meal = initial_values[raw_meal_flow_index]\n",
    "    \n",
    "    input_range = RANGE_PERCENTAGE * initial_values\n",
    "    lower_bounds = initial_values - input_range\n",
    "    upper_bounds = initial_values + input_range\n",
    "\n",
    "    avg_Optimized_PP = pd.DataFrame(columns=names)\n",
    "    avg_optimized_clinker_flow = []\n",
    "    \n",
    "    np.random.seed(1002)\n",
    "    count = 0\n",
    "    number_of_seeds = 10  # iterations for each data point\n",
    "    \n",
    "    for i in tqdm(range(1,number_of_seeds+1)):\n",
    "        print(count)\n",
    "        random.seed(i)\n",
    "        best_inputs, best_fitness,optimized_clinker_flow  = genetic_algorithm()\n",
    "        avg_optimized_clinker_flow.append(optimized_clinker_flow)\n",
    "        PPs = pd.DataFrame(best_inputs).T\n",
    "        PPs.columns = names\n",
    "        avg_Optimized_PP = pd.concat([avg_Optimized_PP, PPs])\n",
    "        count +=1\n",
    "\n",
    "    df = avg_Optimized_PP.apply(pd.to_numeric, errors='coerce')\n",
    "    mean_row = df.mean()\n",
    "    std_row = df.std()\n",
    "    mean_row.name = 'mean'\n",
    "    std_row.name = 'std'\n",
    "    seeds_PP = pd.concat([df, pd.DataFrame([mean_row, std_row])], axis=0)\n",
    "    seeds_PP = seeds_PP.round(4)\n",
    "    avg_best_inputs = seeds_PP.loc['mean'].values\n",
    "    statstics = seeds_PP.iloc[-2:,:]\n",
    "    cleaned_clinker_flow = [x for x in avg_optimized_clinker_flow if x is not None]\n",
    "    if cleaned_clinker_flow:  # Only if list is not empty\n",
    "        statstics['clinker flow rate'] = [np.mean(cleaned_clinker_flow), np.std(cleaned_clinker_flow)]\n",
    "    else:\n",
    "        statstics['clinker flow rate'] = [np.nan, np.nan] \n",
    "\n",
    "    statstics.to_csv(temp_path + f'/optimize_statistics_row{row}.csv')\n",
    "    PPs = pd.DataFrame(avg_best_inputs).T  \n",
    "    PPs.columns = names\n",
    "    initial_values_kf.index =[0]\n",
    "    PPs_kf = pd.concat([PPs,initial_values_kf], axis = 1)\n",
    "        \n",
    "    # fCaO prediction for optimized PPs\n",
    "    X_test_s = scaler_X.transform(PPs_kf)  # apply the scaler used in training the model (see fCaO testin in the notebook)\n",
    "    test_pred_s = model_fCaO.predict(X_test_s).reshape(-1,1)\n",
    "    test_pred = scaler_y.inverse_transform(test_pred_s)\n",
    "    new_fCaO = test_pred[0][0]\n",
    "    new_clinekr_flow = np.mean(cleaned_clinker_flow)   ## Calculating clinker as avg of actual value from optimizatiion\n",
    "\n",
    "    # Prepare Df to compare optimized and initial vals\n",
    "    new_ops = pd.DataFrame([best_fitness,new_clinekr_flow, new_fCaO]).T\n",
    "    final_vals = pd.concat([new_ops,PPs], axis = 1)\n",
    "    final_vals.columns = Op_ip_names\n",
    "\n",
    "    compare_df = pd.concat([initial_values_OP_PP,final_vals ])\n",
    "    compare_df.reset_index(inplace = True)\n",
    "    compare_df.drop(columns=['index'], inplace = True)  \n",
    "    compare_df.loc[len(compare_df)] = np.round(((compare_df.iloc[1] - compare_df.iloc[0])/abs(compare_df.iloc[0]))*100,2)\n",
    "\n",
    "    new_list = [item for item in Op_ip_names if item != 'free_lime']\n",
    "    j = df_filtered_quantile[new_list].describe().loc[['min', 'max']]\n",
    "    j.insert(2, 'free_lime', [0, 2])\n",
    "\n",
    "    compare = pd.concat([compare_df, j])\n",
    "    compare.index = ['initial', 'new', '% change', 'min', 'max']\n",
    "    compare = compare.loc[['% change','initial', 'min','new','max']]\n",
    "    compare.loc['in_limits'] = (compare.loc['new'] >= compare.loc['min']) & (compare.loc['new'] <= compare.loc['max'])\n",
    "    compare = compare.T\n",
    "    t = compare.iloc[3:,:]\n",
    "    t.sort_values(by='% change',key= abs, ascending=False, inplace=True)\n",
    "    compare = pd.concat([compare.iloc[:3,:],t])\n",
    "    compare.to_csv(temp_path + f'/optimize_compare_row{row}.csv')"
